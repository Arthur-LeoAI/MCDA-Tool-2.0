{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AnalysisSettings": {
      "additionalProperties": false,
      "properties": {
        "methods": {
          "default": [
            {
              "method": "weighted_sum"
            }
          ],
          "items": {
            "discriminator": {
              "mapping": {
                "compromise_programming": "#/$defs/CompromiseProgrammingMethod",
                "topsis": "#/$defs/TopsisMethod",
                "weighted_sum": "#/$defs/WeightedSumMethod"
              },
              "propertyName": "method"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/WeightedSumMethod"
              },
              {
                "$ref": "#/$defs/TopsisMethod"
              },
              {
                "$ref": "#/$defs/CompromiseProgrammingMethod"
              }
            ]
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "robustness": {
          "$ref": "#/$defs/RobustnessSettings",
          "default": {
            "mode": "around",
            "samples": 5000,
            "seed": 1,
            "spread": 0.2
          }
        },
        "stability_scope": {
          "default": "full_order",
          "enum": [
            "full_order",
            "top1"
          ],
          "title": "Stability Scope",
          "type": "string"
        }
      },
      "title": "AnalysisSettings",
      "type": "object"
    },
    "BetweenConstraint": {
