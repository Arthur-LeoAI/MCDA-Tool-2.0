                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LinearValueFunction"
                },
                {
                  "$ref": "#/$defs/LogValueFunction"
                },
                {
                  "$ref": "#/$defs/TargetValueFunction"
                },
                {
                  "$ref": "#/$defs/PiecewiseValueFunction"
